{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node --env-file-if-exists=.env scripts/pull-comments.mjs --if-missing",
    "dev": "astro dev",
    "prebuild": "node --env-file-if-exists=.env scripts/pull-comments.mjs",
    "build": "astro build && pagefind --site dist",
    "//build:clean": "Astro caches rendered Markdown in .astro/ and the content store in node_modules/.astro/. Neither is invalidated by an edit to src/plugins/ or to a schema's dependencies, so use this after changing either.",
    "build:clean": "rm -rf dist .astro node_modules/.astro && npm run build",
    "preview": "astro preview",
    "precheck": "node --env-file-if-exists=.env scripts/pull-comments.mjs --if-missing",
    "check": "astro check && npm run lint && npm test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "node --test test/*.test.ts",
    "astro": "astro",
    "comments:pull": "node --env-file-if-exists=.env scripts/pull-comments.mjs",
    "//secret": "Locked posts are encrypted by their author, never by the build. Plaintext lives in secrets/, which is gitignored.",
    "secret:keygen": "node scripts/secret.mjs keygen",
    "secret:rekey": "node scripts/secret.mjs rekey",
    "secret:seal": "node scripts/secret.mjs seal",
    "secret:open": "node scripts/secret.mjs open"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@expressive-code/plugin-collapsible-sections": "^0.44.1",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "astro": "^7.2.1",
    "astro-expressive-code": "^0.44.1",
    "katex": "^0.18.4",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.16.1",
    "pagefind": "^1.5.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-expressive-code": "^0.44.1",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-sectionize": "^2.1.0",
    "satori": "^0.19.3",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  }
}
