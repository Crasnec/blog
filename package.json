{
    "name": "blog",
    "type": "module",
    "imports": {
        "#src/*": "./src/*",
        "#root/*": "./*"
    },
    "version": "0.0.1",
    "engines": {
        "node": ">=22.23.4"
    },
    "scripts": {
        "predev": "node --env-file-if-exists=.env scripts/pull-comments.mjs --if-missing",
        "dev": "astro dev",
        "prebuild": "node --env-file-if-exists=.env scripts/pull-comments.mjs",
        "build": "astro build && pagefind --site dist",
        "//build:clean": "Astro caches rendered Markdown in .astro/ and the content store in node_modules/.astro/. Neither is invalidated by an edit to src/plugins/ or to a schema's dependencies, so use this after changing either.",
        "build:clean": "rm -rf dist .astro node_modules/.astro && npm run build",
        "preview": "astro preview",
        "precheck": "node --env-file-if-exists=.env scripts/pull-comments.mjs --if-missing",
        "check": "npm run check:types && npm run lint && npm test",
        "check:types": "astro sync && npm run tsc -- --noEmit && astro check",
        "tsc": "node node_modules/@typescript/native/bin/tsc",
        "lint": "npm run lint:spacing && npm run lint:format && eslint . --max-warnings 0",
        "lint:spacing": "node scripts/check-spacing.mjs",
        "lint:format": "prettier --check \"**/*.{css,scss,less,json,jsonc,yaml,yml,html,svg}\"",
        "lint:fix": "prettier --write \"**/*.{js,cjs,mjs,ts,cts,mts,tsx,astro,css,scss,less,json,jsonc,yaml,yml,html,svg}\" && eslint . --fix && npm run lint:spacing",
        "test": "node --test test/*.test.ts",
        "test:figures:browser": "node --test test/figures.browser.ts",
        "test:playground:browser": "node --test test/playground.browser.ts",
        "test:search:browser": "node --test test/search.browser.ts",
        "test:contents:browser": "node --test test/contents.browser.ts",
        "astro": "astro",
        "comments:pull": "node --env-file-if-exists=.env scripts/pull-comments.mjs",
        "//figures:shot": "Stills of the animated figures on one page, for checking a figure without watching it. Uses the running dev server, or starts one.",
        "figures:shot": "node scripts/figures-shot.mjs",
        "//secret": "Locked posts are encrypted by their author, never by the build. Plaintext lives in secrets/, which is gitignored.",
        "secret:keygen": "node scripts/secret.mjs keygen",
        "secret:rekey": "node scripts/secret.mjs rekey",
        "secret:seal": "node scripts/secret.mjs seal",
        "secret:open": "node scripts/secret.mjs open",
        "test:locale:browser": "node --test test/locale.browser.ts",
        "test:categories:browser": "node --test test/categories.browser.ts",
        "audit:lighthouse": "node scripts/lighthouse.ts",
        "test:series:browser": "node --test test/series.browser.ts"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.12",
        "@astrojs/markdown-remark": "^7.3.4",
        "@astrojs/mdx": "^8.1.1",
        "@astrojs/react": "7.1.1",
        "@astrojs/sitemap": "^3.7.4",
        "@codemirror/commands": "6.11.1",
        "@codemirror/state": "6.7.6",
        "@codemirror/view": "6.43.15",
        "@expressive-code/plugin-collapsible-sections": "^0.44.1",
        "@expressive-code/plugin-line-numbers": "^0.44.1",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/ibm-plex-sans": "^5.3.0",
        "@fontsource/ibm-plex-sans-kr": "^5.3.0",
        "@fontsource/space-grotesk": "^5.3.0",
        "@fontsource/space-mono": "^5.3.0",
        "astro": "^7.4.2",
        "astro-expressive-code": "^0.44.1",
        "codemirror": "6.0.2",
        "github-slugger": "2.0.0",
        "katex": "^0.18.4",
        "mdast-util-to-string": "^4.0.0",
        "mermaid": "^11.16.1",
        "pagefind": "^1.5.2",
        "pyodide": "314.0.7",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-expressive-code": "^0.44.1",
        "rehype-katex": "^7.0.1",
        "rehype-sanitize": "^6.0.0",
        "rehype-slug": "^6.0.0",
        "rehype-stringify": "^10.0.1",
        "remark-directive": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "remark-sectionize": "^2.1.0",
        "satori": "^0.19.3",
        "shiki": "4.5.0",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.1.0",
        "vscode-textmate": "9.3.2",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/eslint-plugin-jsx-a11y": "^6.10.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "astro-eslint-parser": "^1.4.0",
        "eslint": "^9.39.5",
        "eslint-plugin-astro": "^1.7.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "globals": "^17.11.0",
        "lighthouse": "13.5.0",
        "playwright": "^1.64.1",
        "postcss": "8.5.31",
        "prettier": "3.9.6",
        "prettier-plugin-astro": "1.1.1",
        "typescript-eslint": "^8.67.0"
    }
}
