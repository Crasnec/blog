# Public GitHub repository holding the comment store, as owner/name.
PUBLIC_COMMENTS_REPO=you/blog-comments

# Fine-grained token scoped to that repository, with Actions: write and nothing
# else. It is public in the generated page and exposes that repository's Actions
# API — read the security note in README.md before enabling it. The comment form
# remains visible but disabled until this is set.
PUBLIC_COMMENTS_TOKEN=
