{
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "embeddedLanguageFormatting": "off",
    "plugins": [
        "prettier-plugin-astro"
    ],
    "overrides": [
        {
            "files": "*.astro",
            "options": {
                "embeddedLanguageFormatting": "auto"
            }
        }
    ]
}
