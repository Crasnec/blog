---
import type { GetStaticPaths } from "astro";
import { getCategories, getPostsByCategory } from "../../posts/queries";
import CategoryView from "../../views/CategoryView.astro";
import { flattenCategories } from "../../posts/category";

export const getStaticPaths = (async () => {
    const categories = await getCategories();

    return Promise.all(
        flattenCategories(categories).map(async (category) => ({
            params: { category: category.key },
            props: { category, posts: await getPostsByCategory(category.key) },
        })),
    );
}) satisfies GetStaticPaths;

const { category, posts } = Astro.props;
---

<CategoryView category={category} posts={posts} />
