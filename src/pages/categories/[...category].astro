---
import type { GetStaticPaths } from "astro";
import { getCategories, getPostsByCategory } from "#src/posts/queries.ts";
import CategoryView from "#src/views/CategoryView.astro";
import { flattenCategories } from "#src/posts/category.ts";

export const getStaticPaths = (async () => {
    const categories = await getCategories();

    return Promise.all(
        flattenCategories(categories).map(async (category) => ({
            params: { category: category.key },
            props: { category, posts: await getPostsByCategory(category.key) },
        })),
    );
}) satisfies GetStaticPaths;

const { category, posts } = Astro.props;
---

<CategoryView category={category} posts={posts} />
