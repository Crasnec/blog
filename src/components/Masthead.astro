---
import { siteConfig } from "../config";
---

<div id="masthead-wrapper" class="is-tall" transition:name="masthead" transition:animate="none">
    <div id="masthead" class="shell onload">
        <h1 class="masthead-title">
            <span class="masthead-mark">{siteConfig.title}</span>
        </h1>
        <p class="masthead-sub">{siteConfig.subtitle}</p>
    </div>
</div>
