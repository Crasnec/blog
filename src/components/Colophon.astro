---
import { t } from "../strings";
import type { PostRef } from "../posts/queries";
import { tagSlug } from "../posts/queries";
import { sitePath } from "../utils/url";

interface Props {
    post: PostRef;
}

const { post } = Astro.props;
const { data } = post.entry;
---

{data.tags.length > 0 && (
    <section class="widget">
        <span class="widget-title">{t("post.tags")}</span>
        <ul class="tag-row">
            {data.tags.map((tag) => (
                <li>
                    <a class="tag" href={sitePath(`/tags/${tagSlug(tag)}`)}>
                        {tag}
                    </a>
                </li>
            ))}
        </ul>
    </section>
)}
