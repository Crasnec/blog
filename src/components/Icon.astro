---
/**
 * The complete icon set for the site — nine glyphs, drawn inline.
 *
 * A blog this text-heavy does not need an icon library; shipping one would cost
 * more than the icons are worth and would pull in a second drawing style.
 */
type Name =
	| "search"
	| "sun"
	| "moon"
	| "monitor"
	| "arrow-up"
	| "arrow-left"
	| "arrow-right"
	| "globe"
	| "menu"
	| "close"
	| "lock";

interface Props extends astroHTML.JSX.SVGAttributes {
	name: Name;
}

const { name, ...rest } = Astro.props;

const paths: Record<Name, string> = {
	search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/>',
	sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
	moon: '<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a7 7 0 1 0 10.5 10.5Z"/>',
	monitor:
		'<rect x="2.5" y="4" width="19" height="12.5" rx="1.5"/><path d="M8.5 20.5h7M12 16.5v4"/>',
	"arrow-up": '<path d="M12 19V5M6 11l6-6 6 6"/>',
	"arrow-left": '<path d="M19 12H5M11 18l-6-6 6-6"/>',
	"arrow-right": '<path d="M5 12h14M13 6l6 6-6 6"/>',
	globe:
		'<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z"/>',
	menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
	close: '<path d="M6 6l12 12M18 6 6 18"/>',
	lock: '<rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>',
};
---

<svg
	{...rest}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	set:html={paths[name]}
/>
