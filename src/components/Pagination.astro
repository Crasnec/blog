---
import { t } from "#src/strings.ts";
import type { Page } from "astro";
import type { PostRef } from "#src/posts/queries.ts";
import Icon from "#src/components/Icon.astro";

interface Props {
    page: Page<PostRef>;
}

const { page } = Astro.props;
---

{page.lastPage > 1 && (
    <nav class="pagination" aria-label={t("nav.posts")}>
        {page.url.prev ? (
            <a class="pagination-link bloom" href={page.url.prev}>
                <Icon name="arrow-left" class="pagination-arrow" />
                {t("page.prev")}
            </a>
        ) : (
            <span class="pagination-link is-disabled">
                <Icon name="arrow-left" class="pagination-arrow" />
                {t("page.prev")}
            </span>
        )}

        <span class="pagination-spacer" />

        <span class="pagination-state">
            {page.currentPage} / {page.lastPage}
        </span>

        <span class="pagination-spacer" />

        {page.url.next ? (
            <a class="pagination-link bloom" href={page.url.next}>
                {t("page.next")}
                <Icon name="arrow-right" class="pagination-arrow" />
            </a>
        ) : (
            <span class="pagination-link is-disabled">
                {t("page.next")}
                <Icon name="arrow-right" class="pagination-arrow" />
            </span>
        )}
    </nav>
)}
