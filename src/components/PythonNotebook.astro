---
import { t } from "#src/strings.ts";
import "#src/playground/style.css";
interface Props {
    id: string;
    title?: string;
    attribution?: string;
}
const { id, title = t("notebook.title"), attribution } = Astro.props;
if (!/^[a-zA-Z][\w-]{0,79}$/u.test(id)) {
    throw new Error("PythonNotebook needs a valid ID");
}
---

<aside
    class="python-notebook"
    data-python-notebook={id}
    data-attribution={attribution}
    aria-label={title}
>
    <strong class="notebook-title">{title}</strong>
    <p>{t("notebook.instructions")}</p>
    <div class="notebook-actions">
        <button type="button" class="btn-solid notebook-run-all" disabled>
            {t("notebook.runAll")}
        </button>
        <button type="button" class="btn bloom notebook-restart" disabled>
            {t("notebook.restart")}
        </button>
        <button type="button" class="btn bloom notebook-download" disabled>
            {t("notebook.download")}
        </button>
        <span class="notebook-status" role="status">
            {t("playground.idle")}
        </span>
    </div>
</aside>
