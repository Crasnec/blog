---
import { t } from "../strings";
import {
    decodeConfig,
    MAX_CODE,
    MAX_INPUT,
    runtimeFor,
    type GrammarSource,
    type Runtime,
    type PythonPackage,
} from "../playground/contracts";
import { parseGrammars } from "../playground/grammar";
import "../playground/style.css";

interface Props {
    code: string;
    language?: string;
    runtime?: Runtime | false;
    title?: string;
    grammars?: GrammarSource[];
    timeout?: number;
    pythonPackages?: PythonPackage[];
    notebook?: string;
    runAll?: boolean;
}

const {
    code,
    language = "javascript",
    runtime = runtimeFor(language),
    title = language,
    grammars = [],
    timeout = 10_000,
    pythonPackages = [],
    notebook,
    runAll = true,
} = Astro.props;
if (typeof code !== "string" || code.length > MAX_CODE)
{
    throw new Error("CodePlayground code must be a string of at most 100000 characters");
}
const config = decodeConfig(
    JSON.stringify({
        language,
        runtime,
        grammars,
        timeout,
        label: title,
        pythonPackages,
        notebook,
    }),
);
parseGrammars(config.grammars);
---

<section
    class="code-playground"
    data-code-playground
    data-notebook={notebook}
    data-run-all={runAll ? undefined : "false"}
    data-config={JSON.stringify(config)}
    aria-label={title}
>
    <div class="playground-toolbar">
        <div class="playground-caption">
            <strong class="playground-title">{title}</strong>
            {notebook && (
                <span class="notebook-execution" aria-label={t("notebook.execution")}>
                    [ ]
                </span>
            )}
            <span class="playground-language">{language}</span>
        </div>
        <div class="playground-actions">
            {runtime && (
                <button
                    class="btn-solid playground-run"
                    type="button"
                    disabled
                    title="Ctrl/⌘ + Enter"
                >
                    {t("playground.run")}
                </button>
            )}
            {runtime && (
                <button class="btn bloom playground-stop" type="button" disabled>
                    {t("playground.stop")}
                </button>
            )}
            <button class="btn bloom playground-reset" type="button" disabled>
                {t("playground.reset")}
            </button>
        </div>
    </div>
    <div class="playground-editor">
        <textarea
            class="playground-fallback"
            aria-label={`${title}: ${t("playground.code")}`}
            readonly
            spellcheck="false"
            wrap="off"
            rows={notebook ? Math.min(20, code.split("\n").length + 1) : undefined}
        >{code}</textarea>
    </div>
    {runtime === "python" && !notebook && (
        <p class="playground-libraries">{t("playground.pythonLibraries")}</p>
    )}
    {notebook && (
        <p class="notebook-stale" hidden>
            {t("notebook.stale")}
        </p>
    )}
    <p class="playground-highlight-status" role="status" hidden></p>
    {runtime && (
        <div class="playground-results">
            <div class="playground-output-heading">
                <span>{t("playground.output")}</span>
                <span class="playground-status" role="status">
                    {t("playground.idle")}
                </span>
            </div>
            {/* Scrollable output needs a keyboard target for arrow and Page Down keys. */}
            {/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex */}
            <div
                class="playground-output"
                role="region"
                aria-label={`${title}: ${t("playground.output")}`}
                tabindex="0"
                data-pagefind-ignore
            >
                {Astro.slots.has("default") && (
                    <div class="playground-reference">
                        <p class="notebook-reference-label">{t("notebook.reference")}</p>
                        <slot />
                    </div>
                )}
            </div>
            {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
            <form class="playground-input" hidden>
                <label class="playground-input-label">
                    <span class="playground-input-prompt">{t("playground.inputLabel")}</span>
                    <input
                        class="field-input playground-input-value"
                        type="text"
                        maxlength={MAX_INPUT}
                        autocomplete="off"
                        spellcheck="false"
                    />
                </label>
                <div class="playground-input-actions">
                    <button type="submit" class="btn-solid">
                        {t("playground.inputSend")}
                    </button>
                    <button type="button" class="btn bloom playground-input-eof">
                        {t("playground.inputEof")}
                    </button>
                </div>
            </form>
        </div>
    )}
    <noscript>
        <p>{t("playground.needsJs")}</p>
    </noscript>
</section>
