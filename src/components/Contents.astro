---
import { t } from "../strings";
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../config";

interface Props {
    headings: MarkdownHeading[];
    variant?: "rail" | "inline";
}

const { headings, variant = "rail" } = Astro.props;

const structural = headings.filter((h) => h.slug !== "footnote-label");

const minDepth = structural.length ? Math.min(...structural.map((h) => h.depth)) : 2;

const items = structural
    .filter((h) => h.depth >= minDepth && h.depth < minDepth + siteConfig.tocDepth)
    .map((h) => ({ ...h, level: h.depth === minDepth ? 2 : 3 }));

const strip = (text: string) => text.replace(/\s*#\s*$/, "");
---

{items.length > 0 &&
    (variant === "rail" ? (
        <section id="contents" class="widget contents">
            <span class="widget-title" id="contents-heading">
                {t("toc.title")}
            </span>

            <nav class="contents-scroll" aria-labelledby="contents-heading">
                <ol class="contents-list">
                    {items.map((item) => (
                        <li>
                            <a
                                class="contents-item"
                                href={`#${item.slug}`}
                                data-depth={item.level}
                                data-slug={item.slug}
                            >
                                <span class="contents-text">{strip(item.text)}</span>
                            </a>
                        </li>
                    ))}
                </ol>
            </nav>
        </section>
    ) : (
        <details class="contents-inline">
            <summary>{t("toc.title")}</summary>
            <ol class="contents-inline-list">
                {items.map((item) => (
                    <li data-depth={item.level}>
                        <a href={`#${item.slug}`}>{strip(item.text)}</a>
                    </li>
                ))}
            </ol>
        </details>
    ))}
