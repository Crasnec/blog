---
import { t } from "../strings";
import { privateKey } from "../utils/keys";
import type { SecretPayload } from "../utils/secret";
import Icon from "./Icon.astro";

/**
 * What a locked post shows instead of its body.
 *
 * The ciphertext is on the page and the plaintext is not — there is no copy of
 * the body anywhere in `dist/` to find. Unlocking replaces this block with the
 * decrypted article, in the same `.prose` container an ordinary post uses, so
 * everything below the fold is styled by the same rules.
 */
interface Props {
	payload: SecretPayload;
}

const { payload } = Astro.props;
const wrappedKey = privateKey();
---

<div id="secret" class="secret">
	<div class="secret-head">
		<Icon name="lock" class="secret-icon" />
		<span class="secret-title">{t("secret.locked")}</span>
	</div>

	<form
		id="secret-form"
		class="secret-form"
		data-working={t("secret.working")}
		data-wrong={t("secret.wrong")}
	>
		<label class="visually-hidden" for="secret-input">
			{t("secret.passphrase")}
		</label>
		<input
			id="secret-input"
			class="field-input secret-input"
			type="password"
			autocomplete="off"
			spellcheck="false"
			placeholder={t("secret.passphrase")}
			required
		/>
		<button class="btn-solid" type="submit">{t("secret.open")}</button>
	</form>

	<p id="secret-status" class="secret-status" role="status" hidden></p>
</div>

<!--
	The body arrives here on unlock. It is empty in the served HTML, and the only
	thing shipped alongside it is ciphertext.

	`prose` but not `post-body`: the entrance stagger starts its children at zero
	opacity, which is right for content that loads with the page and wrong for
	content that appears because the reader asked for it.
-->
<div id="secret-body" class="prose"></div>

<script id="secret-payload" type="application/json" set:html={JSON.stringify(payload)} is:inline></script>

<!--
	The private key, wrapped in the same passphrase the reader is about to type.
	It is on the page for the same reason the ciphertext is: publishing it costs
	nothing that publishing the ciphertext did not already cost, and it saves the
	reader from having to carry a key file to open a post they were sent a link
	to. See `src/utils/secret.ts`.
-->
<script id="secret-key" type="application/json" set:html={JSON.stringify(wrappedKey)} is:inline></script>
