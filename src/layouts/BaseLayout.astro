---
import { HTML_LANG, t } from "#src/strings.ts";
import { ClientRouter } from "astro:transitions";
import BackToTop from "#src/components/BackToTop.astro";
import BaseHead from "#src/components/BaseHead.astro";
import Masthead from "#src/components/Masthead.astro";
import Navbar from "#src/components/Navbar.astro";
import Search from "#src/components/Search.astro";

interface Props {
    title?: string | undefined;
    description?: string | undefined;
    article?: boolean | undefined;
    publishedTime?: Date | undefined;
    modifiedTime?: Date | undefined;
    card?: string | undefined;
    section?: string | undefined;
}

const { title, description, article, publishedTime, modifiedTime, card, section } = Astro.props;
---

<!doctype html>
<html lang={HTML_LANG} class="no-js" data-theme="auto">
    <head>
        <BaseHead
            title={title}
            description={description}
            article={article}
            publishedTime={publishedTime}
            modifiedTime={modifiedTime}
            card={card}
            section={section}
        />
        <ClientRouter />
        <slot name="head" />
    </head>

    <body class="page">
        <a class="skip-link" href="#content">
            {t("action.skip")}
        </a>

        <Navbar />
        <Masthead />

        <div id="main">
            <div id="main-grid" class="shell">
                <slot name="sidebar" />

                <!-- Use the viewport fade; a separate article snapshot morphs its full size. -->
                <main id="content" class="onload" tabindex="-1">
                    <slot />
                </main>
            </div>
        </div>

        <BackToTop />
        <Search />

        <script>
            import "#src/scripts/ui.ts";
        </script>
    </body>
</html>
