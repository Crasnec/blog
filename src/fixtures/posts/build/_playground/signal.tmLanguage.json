{
    "name": "Signal",
    "scopeName": "source.signal",
    "patterns": [
        { "include": "#comments" },
        { "include": "source.signal-values" },
        { "name": "keyword.control.signal", "match": "\\b(series|mean|emit)\\b" },
        { "name": "keyword.operator.signal", "match": "->|=" }
    ],
    "repository": {
        "comments": { "name": "comment.line.signal", "match": "#.*$" }
    }
}
