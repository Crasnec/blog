{
    "name": "Signal values",
    "scopeName": "source.signal-values",
    "patterns": [
        { "name": "constant.numeric.signal", "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b" },
        {
            "name": "string.quoted.double.signal",
            "begin": "\"",
            "end": "\"",
            "patterns": [{ "name": "constant.character.escape.signal", "match": "\\\\." }]
        }
    ]
}
