---
import { t } from "../strings";
import { getEntry, render } from "astro:content";
import Sidebar from "../components/Sidebar.astro";
import { profileConfig } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";

const entry = await getEntry("pages", "about");
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---

<BaseLayout
	title={entry?.data.title ?? t("nav.about")}
	description={entry?.data.description}
>
	<Sidebar slot="sidebar" />

	<!-- The masthead already says this. Kept for the document outline. -->
	<h1 class="visually-hidden">{entry?.data.title ?? t("nav.about")}</h1>

	<div class="prose">
		{
			Content ? (
				<Content />
			) : (
				<p>{profileConfig.bio}</p>
			)
		}

		<ul>
			{
				profileConfig.links.map((link) => (
					<li>
						<a href={link.url} rel={link.url.startsWith("http") ? "me noopener" : undefined}>
							{link.name}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>
