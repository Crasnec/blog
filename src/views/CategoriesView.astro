---
import { countLabel } from "../utils/format";
import { t } from "../strings";
import Sidebar from "../components/Sidebar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCategories } from "../utils/content";
import { sitePath } from "../utils/url";

/** Each nonempty post folder contributes one category and its count. */
const categories = await getCategories();
---

<BaseLayout
	title={t("categories.title")}
>
	<Sidebar slot="sidebar" />

	<!-- The masthead already says this. Kept for the document outline. -->
	<h1 class="visually-hidden">{t("categories.title")}</h1>

	{
		categories.length === 0 ? (
			<p class="empty-note">{t("index.empty")}</p>
		) : (
			<ul class="category-list">
				{categories.map(({ key, name, count }) => (
					<li class="category-item">
						<a
							class="category-link"
							href={sitePath(`/categories/${encodeURIComponent(key)}`)}
						>
							<span class="category-name">{name}</span>
							<span class="category-tally">{countLabel(count)}</span>
						</a>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>
