---
import PostEntry from "#src/components/PostEntry.astro";
import Sidebar from "#src/components/Sidebar.astro";
import BaseLayout from "#src/layouts/BaseLayout.astro";
import { t } from "#src/strings.ts";
import type { PostRef } from "#src/posts/queries.ts";
import { countLabel } from "#src/utils/format.ts";
import type { PostSeries } from "#src/posts/series.ts";
import { sitePath } from "#src/utils/url.ts";

interface Props {
    series: PostSeries<PostRef>;
}

const { series } = Astro.props;
---

<BaseLayout title={series.name}>
    <Sidebar slot="sidebar" />
    <div class="page-intro">
        <a class="link-text mono" href={sitePath("/series/")}>
            {t("series.title")}
        </a>
        <h1>{series.name}</h1>
        <p class="post-meta-note">{countLabel(series.parts.length)}</p>
    </div>
    <ol class="entry-list">
        {series.parts.map(({ post }) => (
            <PostEntry post={post} />
        ))}
    </ol>
</BaseLayout>
