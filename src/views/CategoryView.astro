---
import PostEntry from "#src/components/PostEntry.astro";
import Sidebar from "#src/components/Sidebar.astro";
import CategoryBreadcrumbs from "#src/components/CategoryBreadcrumbs.astro";
import CategoryTree from "#src/components/CategoryTree.astro";
import { t } from "#src/strings.ts";
import BaseLayout from "#src/layouts/BaseLayout.astro";
import type { PostRef } from "#src/posts/queries.ts";
import { categoryLabel, type CategoryCount } from "#src/posts/category.ts";

interface Props {
    category: CategoryCount;
    posts: PostRef[];
}

const { category, posts } = Astro.props;
---

<BaseLayout title={categoryLabel(category)}>
    <Sidebar slot="sidebar" currentCategory={category.key} />

    <!-- Nothing else on the page says which one you are looking at. -->
    <div class="page-intro">
        {category.trail.length > 1 && <CategoryBreadcrumbs category={category} current />}
        <h1>{category.name}</h1>
    </div>
    {category.children.length > 0 && (
        <nav class="category-children" aria-label={t("categories.title")}>
            <CategoryTree categories={category.children} variant="index" />
        </nav>
    )}

    <ul class="entry-list">
        {posts.map((post) => (
            <PostEntry post={post} />
        ))}
    </ul>
</BaseLayout>
