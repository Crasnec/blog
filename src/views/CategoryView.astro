---
import PostEntry from "../components/PostEntry.astro";
import Sidebar from "../components/Sidebar.astro";
import CategoryBreadcrumbs from "../components/CategoryBreadcrumbs.astro";
import CategoryTree from "../components/CategoryTree.astro";
import { t } from "../strings";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { PostRef } from "../posts/queries";
import { categoryLabel, type CategoryCount } from "../posts/category";

interface Props {
    category: CategoryCount;
    posts: PostRef[];
}

const { category, posts } = Astro.props;
---

<BaseLayout title={categoryLabel(category)}>
    <Sidebar slot="sidebar" currentCategory={category.key} />

    <!-- Nothing else on the page says which one you are looking at. -->
    <div class="page-intro">
        {category.trail.length > 1 && <CategoryBreadcrumbs category={category} current />}
        <h1>{category.name}</h1>
    </div>
    {category.children.length > 0 && (
        <nav class="category-children" aria-label={t("categories.title")}>
            <CategoryTree categories={category.children} variant="index" />
        </nav>
    )}

    <ul class="entry-list">
        {posts.map((post) => (
            <PostEntry post={post} />
        ))}
    </ul>
</BaseLayout>
