---
import { countLabel, machineDate, shortStampDate, yearLabel } from "#src/utils/format.ts";
import { t } from "#src/strings.ts";
import Icon from "#src/components/Icon.astro";
import Sidebar from "#src/components/Sidebar.astro";
import BaseLayout from "#src/layouts/BaseLayout.astro";
import { groupByYear } from "#src/posts/queries.ts";

const years = await groupByYear();
---

<BaseLayout title={t("archive.title")}>
    <Sidebar slot="sidebar" />

    <!-- The masthead already says this. Kept for the document outline. -->
    <h1 class="visually-hidden">{t("archive.title")}</h1>

    {years.length === 0 ? (
        <p class="empty-note">{t("index.empty")}</p>
    ) : (
        years.map(({ year, posts }) => (
            <section class="year-group" id={`y${String(year)}`}>
                <div class="year-head">
                    <span class="year-number">{yearLabel(year)}</span>
                    <span class="year-count">{countLabel(posts.length)}</span>
                </div>

                <ul class="archive-list">
                    {posts.map(({ entry, href }) => (
                        <li class="archive-item">
                            <a class="archive-link" href={href}>
                                <time
                                    class="archive-day"
                                    datetime={machineDate(entry.data.published)}
                                >
                                    {shortStampDate(entry.data.published)}
                                </time>
                                <span class="archive-title">{entry.data.title}</span>
                                {entry.data.sealed && (
                                    <Icon name="lock" class="lock-icon archive-lock" />
                                )}
                            </a>
                        </li>
                    ))}
                </ul>
            </section>
        ))
    )}
</BaseLayout>
