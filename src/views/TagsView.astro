---
import { t } from "#src/strings.ts";
import Sidebar from "#src/components/Sidebar.astro";
import BaseLayout from "#src/layouts/BaseLayout.astro";
import { getTags, tagSlug } from "#src/posts/queries.ts";
import { sitePath } from "#src/utils/url.ts";

const tags = await getTags();
---

<BaseLayout title={t("tags.title")}>
    <Sidebar slot="sidebar" />

    <!-- The masthead already says this. Kept for the document outline. -->
    <h1 class="visually-hidden">{t("tags.title")}</h1>

    {tags.length === 0 ? (
        <p class="empty-note">{t("index.empty")}</p>
    ) : (
        <ul class="tag-row is-large">
            {tags.map(({ tag, count }) => (
                <li>
                    <a class="tag" href={sitePath(`/tags/${tagSlug(tag)}`)}>
                        {tag}
                        <span class="tag-count">{count}</span>
                    </a>
                </li>
            ))}
        </ul>
    )}
</BaseLayout>
