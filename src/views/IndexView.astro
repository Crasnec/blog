---
import { t } from "#src/strings.ts";
import type { Page } from "astro";
import Pagination from "#src/components/Pagination.astro";
import PostEntry from "#src/components/PostEntry.astro";
import Sidebar from "#src/components/Sidebar.astro";
import BaseLayout from "#src/layouts/BaseLayout.astro";
import type { PostRef } from "#src/posts/queries.ts";

interface Props {
    page: Page<PostRef>;
}

const { page } = Astro.props;
---

<BaseLayout>
    <Sidebar slot="sidebar" />

    {page.data.length === 0 ? (
        <p class="empty-note">{t("index.empty")}</p>
    ) : (
        <ul class="entry-list">
            {page.data.map((post) => (
                <PostEntry post={post} />
            ))}
        </ul>
    )}

    <Pagination page={page} />
</BaseLayout>
